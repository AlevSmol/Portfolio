---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/layouts/header.astro';
import Footer from '../components/layouts/footer.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portafolio personal - Desarrollador Fullstack" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-dark text-light relative min-h-screen flex flex-col overflow-x-hidden">
    <div class="absolute top-0 z-[-20] h-screen w-screen bg-dark bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(147,61,201,0.3),rgba(0,0,0,0))]"></div>
    <Header />
    <slot />
    <Footer/>
  </body>
</html>