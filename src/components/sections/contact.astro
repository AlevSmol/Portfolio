---
---

<section id="contact" class="py-20 relative !z-10 px-4 md:px-24 grow pb-32 bg-gradient-to-b from-dark to-purplet rounded-b-[40px]">
  <div class="max-w-[700px] mx-auto">
    <!-- Blobs de fondo -->
    <div class="absolute top-0 -z-10 h-[300px] w-[300px] bg-violett rounded-full blur-[128px] opacity-20"></div>
    <div class="absolute bottom-0 right-0 -z-10 h-[300px] w-[300px] bg-purplet rounded-full blur-[128px] opacity-20"></div>

    <h2 class="text-3xl font-bold mb-6 flex gap-x-3 items-center text-light">
      <svg
        class="size-7 text-violett"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H18c2.5 0 4 2 4 4.5Z"/>
        <path d="m2 9 10 5 10-5"/>
        <path d="m2 14 10 5 10-5"/>
      </svg>
      Contacto
    </h2>

    <p class="text-light/80 mb-8">
      ¿Tienes alguna pregunta o propuesta? No dudes en contactarme. Estaré encantado de escucharte.
    </p>

    <form 
      action="https://formsubmit.co/arledavidv17@gmail.com" 
      method="POST"
      class="flex flex-col gap-4"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-light/80 mb-2">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2 rounded-lg bg-light/5 border border-light/10 text-light focus:outline-hidden focus:border-violett transition-colors"
            placeholder="Tu nombre"
          />
        </div>
        <div>
          <label for="email" class="block text-light/80 mb-2">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2 rounded-lg bg-light/5 border border-light/10 text-light focus:outline-hidden focus:border-violett transition-colors"
            placeholder="tu@email.com"
          />
        </div>
      </div>

      <div>
        <label for="subject" class="block text-light/80 mb-2">Asunto</label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="w-full px-4 py-2 rounded-lg bg-light/5 border border-light/10 text-light focus:outline-hidden focus:border-violett transition-colors"
          placeholder="Asunto del mensaje"
        />
      </div>

      <div>
        <label for="message" class="block text-light/80 mb-2">Mensaje</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          class="w-full px-4 py-2 rounded-lg bg-light/5 border border-light/10 text-light focus:outline-hidden focus:border-violett transition-colors resize-none"
          placeholder="Tu mensaje aquí..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="px-8 py-3 bg-violett text-light font-semibold rounded-lg hover:bg-violett/80 transition-colors mt-4 w-full md:w-auto md:self-start"
      >
        Enviar mensaje
      </button>

      <!-- Campos ocultos para FormSubmit -->
      <input type="hidden" name="_subject" value="Nuevo mensaje desde el portafolio">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="https://tu-portfolio.com/gracias">
    </form>
  </div>
</section>