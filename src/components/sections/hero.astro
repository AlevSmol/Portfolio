---
import LogoCarousel from "../react/ui/LogoCarousel";
import FeaturedProjectCard from "../react/FeaturedProjectCard";
import { getCollection } from "astro:content";

const featuredProjects = (await getCollection("projects"))
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const SOCIAL_LINKS = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/arle-villasmil-a09098395/",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="fill: currentColor;">
      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
    </svg>`
  },
  {
    name: "GitHub",
    url: "https://github.com/AlevSmol",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="fill: currentColor;">
      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
    </svg>`
  }
];
---

<section
  id="hero"
  class="pt-44 flex flex-col items-center justify-center !z-[10] px-4 md:px-24 grow bg-dark relative"
>
  <div class="absolute top-0 -z-10 h-[300px] w-[300px] bg-violett rounded-full blur-[128px] opacity-40"></div>
  <div class="absolute bottom-0 right-0 -z-10 h-[500px] w-[500px] bg-purple rounded-full blur-[128px] opacity-20"></div>

  <div class="flex flex-col items-center justify-center">
    <div class="relative mb-4">
      <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-violett to-purplet blur-md animate-pulse"></div>
      <div class="relative size-32 rounded-full border-4 border-light/10">
        <LogoCarousel client:visible />
      </div>
    </div>

    <h1 class="text-4xl lg:text-5xl font-bold text-center text-gray-100 flex flex-col md:flex-row gap-2 items-center">
      ¡Hola, soy Arle Villasmil!
    </h1>

    <h2 class="text-xl lg:text-2xl text-center text-wrap max-w-[700px] text-gray-300 mt-4">
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-blue-500">
        Analista y Desarrollador Web Fullstack
      </span>{" "}
      creando experiencias web únicas y eficientes
    </h2>

    <nav class="flex gap-4 mt-8 flex-wrap justify-center">
      {
        SOCIAL_LINKS.map(({ name, url, icon }) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white/5 border border-white/10 rounded-full px-4 py-2 flex gap-2 items-center
                   transition hover:scale-110 hover:bg-white/10"
          >
            <Fragment set:html={icon} />
            {name}
          </a>
        ))
      }
    </nav>

    {/* Featured Projects */}
    {featuredProjects.length > 0 && (
      <div class="mt-14 w-full max-w-2xl">
        <h3 class="text-sm uppercase tracking-wider text-purple-400 font-semibold mb-4 text-center">
          Proyectos Destacados
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {featuredProjects.map((project, i) => {
            const imageUrl = `${import.meta.env.BASE_URL}/${project.data.image[0]}`;
            return (
              <FeaturedProjectCard
                title={project.data.title}
                resume={project.data.resume}
                image={imageUrl}
                tags={project.data.tags}
                link={project.id}
                status={project.data.status}
                index={i}
                baseUrl={import.meta.env.BASE_URL}
                client:visible
              />
            );
          })}
        </div>
      </div>
    )}

    <div class="mt-16 animate-bounce">
      <a href="#about" class="text-sm text-gray-400 flex flex-col items-center gap-2">
        Scroll down
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14"/>
          <path d="m19 12-7 7-7-7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
