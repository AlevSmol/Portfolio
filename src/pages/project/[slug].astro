---
import Layout from "../../layouts/Layout.astro";
import StorySection from "@/components/react/StorySection";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project: CollectionEntry<"projects">) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const year = project.data.date.getFullYear();
const images = project.data.image.map(img =>
  img.startsWith('http') ? img : `${import.meta.env.BASE_URL}/${img}`
);
const isInProgress = project.data.status === 'in-progress';
---

<Layout title={`Proyecto: ${project.data.title}`}>
  <main class="w-full z-10 text-gray-200 bg-dark min-h-screen">
    <div class="absolute top-18 -z-10 h-screen w-screen bg-dark bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(147,61,201,0.3),rgba(0,0,0,0))]"></div>

    {/* Sticky header */}
    <div class="sticky top-0 z-20 bg-dark/80 backdrop-blur-md border-b border-white/5 px-4 md:px-12 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a
          href={`${import.meta.env.BASE_URL}/#projects`}
          data-astro-reload
          class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Volver
        </a>
        <div class="flex items-center gap-3">
          {isInProgress && (
            <span class="flex items-center gap-1.5 bg-amber-500/20 text-amber-300 text-xs font-semibold px-2.5 py-1 rounded-full">
              <span class="w-1.5 h-1.5 bg-amber-400 rounded-full animate-pulse"></span>
              En desarrollo
            </span>
          )}
          <span class="text-sm text-gray-500">{year}</span>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 md:px-8 pb-20">
      {/* Title section */}
      <StorySection client:visible>
        <div class="pt-12 pb-8">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{project.data.title}</h1>
          <p class="text-xl text-gray-300 mb-6">{project.data.resume}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <span class="bg-purple-500/20 text-purple-300 text-sm rounded-full px-3 py-1 font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </StorySection>

      {/* Hero image */}
      <StorySection delay={0.1} client:visible>
        <div class="rounded-2xl overflow-hidden shadow-2xl shadow-purple-900/20 mb-16">
          <img
            src={images[0]}
            alt={project.data.title}
            class="w-full h-auto object-cover"
          />
        </div>
      </StorySection>

      {/* Description section */}
      <StorySection delay={0.1} client:visible>
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-3">
            <span class="w-8 h-0.5 bg-gradient-to-r from-violett to-purple-400"></span>
            Descripción
          </h2>
          <p class="text-lg text-gray-300 leading-relaxed">{project.data.description}</p>
        </section>
      </StorySection>

      {/* Second image if exists */}
      {images.length > 1 && (
        <StorySection delay={0.1} client:visible>
          <div class="rounded-2xl overflow-hidden shadow-xl mb-16">
            <img
              src={images[1]}
              alt={`${project.data.title} - captura 2`}
              class="w-full h-auto object-cover"
            />
          </div>
        </StorySection>
      )}

      {/* Solution / Details section */}
      <StorySection delay={0.1} client:visible>
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-3">
            <span class="w-8 h-0.5 bg-gradient-to-r from-violett to-purple-400"></span>
            Detalles Técnicos
          </h2>
          <p class="text-lg text-gray-300 leading-relaxed mb-6">{project.data.details}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <span class="bg-white/5 border border-white/10 text-gray-300 text-sm rounded-lg px-4 py-2">
                {tag}
              </span>
            ))}
          </div>
        </section>
      </StorySection>

      {/* Third image if exists */}
      {images.length > 2 && (
        <StorySection delay={0.1} client:visible>
          <div class="rounded-2xl overflow-hidden shadow-xl mb-16">
            <img
              src={images[2]}
              alt={`${project.data.title} - captura 3`}
              class="w-full h-auto object-cover"
            />
          </div>
        </StorySection>
      )}

      {/* Markdown content (result) */}
      <StorySection delay={0.1} client:visible>
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-0.5 bg-gradient-to-r from-violett to-purple-400"></span>
            Más información
          </h2>
          <div class="prose prose-invert prose-purple max-w-none
                      prose-headings:text-white prose-p:text-gray-300
                      prose-a:text-purple-400 prose-strong:text-white">
            <Content />
          </div>
        </section>
      </StorySection>

      {/* CTA */}
      <StorySection delay={0.1} client:visible>
        <div class="flex justify-center pt-4">
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-3 bg-gradient-to-r from-violett to-purple-600
                   text-white font-semibold rounded-full hover:scale-105 hover:shadow-lg
                   hover:shadow-purple-500/30 transition-all"
          >
            Ver proyecto
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </StorySection>
    </div>
  </main>
</Layout>
